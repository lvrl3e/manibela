generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OtpPurpose {
  PASSWORD_RESET
  SIGNUP_VERIFICATION
  PHONE_CHANGE
}

enum IdVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  ACTIVE
  COMPLETED
}

/// Where a flagged trip stands in admin review. PENDING until an admin
/// looks at it; REVIEWED is a neutral "looked at, no verdict yet" state
/// distinct from the two verdicts (VALID/INVALID) — see POST
/// /api/admin/trips/:id/review.
enum TripReviewStatus {
  PENDING
  REVIEWED
  VALID
  INVALID
}

enum ComplaintStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  REJECTED
}

model Commuter {
  id              String    @id @default(cuid())
  commuterId      String    @unique
  fullName        String
  mobileNumber    String    @unique
  passwordHash    String
  dateOfBirth     DateTime? @db.Date
  photoUrl        String?

  /// Set once the commuter verifies the OTP sent at signup. Null until
  /// then — nothing currently gates on this being set (the ID/KYC steps
  /// after it are still fully mocked), it's just a record that the
  /// number was actually confirmed.
  phoneVerifiedAt DateTime?

  /// Carried over from PendingCommuterSignup at signup redemption — the
  /// government ID type/photos and selfie captured during onboarding.
  /// Stored for the account's lifetime as the KYC record.
  idType          String?
  idFrontUrl      String?
  idBackUrl       String?
  selfieUrl       String?

  /// 0-100 similarity between [selfieUrl] and the photo on [idFrontUrl],
  /// computed once at /signup via lib/faceMatch.ts (face-api.js, local —
  /// no vendor/API key). Null means the comparison couldn't confidently
  /// find a face in one or both photos (bad lighting, face not fully in
  /// frame, model failed to load, etc.) — treated exactly like a
  /// below-threshold score, never blocks signup. Purely informational
  /// once set; an admin's later APPROVED/REJECTED call doesn't touch it.
  faceMatchScore  Int?

  /// Null until ID/selfie is submitted (nothing to review yet); set at
  /// /signup to APPROVED (auto-cleared, see FACE_MATCH_AUTO_CLEAR_SCORE
  /// in lib/faceMatch.ts) or PENDING (below threshold / no score),
  /// then — for anything still PENDING — moved to APPROVED/REJECTED by
  /// an admin via POST /api/admin/commuters/:id/verify.
  verificationStatus IdVerificationStatus?

  /// Whether this account can log in — same enforcement point as
  /// verificationStatus in POST /login. Defaults to false: a brand-new
  /// signup isn't "active" until it's APPROVED — either automatically at
  /// /signup (a high enough faceMatchScore) or later by an admin via
  /// POST /api/admin/commuters/:id/verify, both of which flip this to
  /// true alongside verificationStatus. An admin can also flip it back
  /// to false later to soft-disable an already-approved account without
  /// deleting it.
  isActive        Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Driver {
  id            String    @id @default(cuid())
  driverId      String    @unique
  fullName      String
  mobileNumber  String    @unique
  passwordHash  String
  plateNumber   String
  dateOfBirth   DateTime? @db.Date
  photoUrl      String?

  /// Front + back of this driver's license, plus the face-verification
  /// selfie, all submitted together by the driver themselves (Settings
  /// -> License Number -> upload/take photo -> submit; see POST
  /// /api/driver/me/license-photo, which requires all three). Null
  /// until submitted. There's no admin-side photo upload anymore —
  /// uploading is the driver's own job now.
  licenseFrontUrl String?
  licenseBackUrl  String?
  selfieUrl       String?

  /// 0-100 similarity between [selfieUrl] and the photo on
  /// [licenseFrontUrl], computed at submission via lib/faceMatch.ts —
  /// same mechanism and threshold as Commuter.faceMatchScore, see its
  /// own doc comment for the full explanation. Null means the
  /// comparison couldn't confidently find a face in one or both photos;
  /// treated exactly like a below-threshold score.
  faceMatchScore  Int?

  /// The license number on file. Set one of two ways, both admin-only,
  /// via PATCH /api/admin/drivers/:id/license-number: recorded directly
  /// (e.g. at Add Driver, or a later correction — no photo required), or
  /// typed in after reviewing a submitted photo alongside approving/
  /// rejecting it. Never auto-detected/OCR'd either way — stays null for
  /// a submission the face-match auto-cleared rather than an admin ever
  /// reviewing it; an admin can still fill it in later if they want the
  /// record complete.
  licenseNumber String?

  /// PENDING once the driver submits license photos with a below-
  /// threshold/no faceMatchScore; APPROVED immediately if the score
  /// auto-clears it (same threshold as Commuter, see
  /// FACE_MATCH_AUTO_CLEAR_SCORE in lib/faceMatch.ts) or otherwise by an
  /// admin reviewing a PENDING one (PATCH /api/admin/drivers/:id/
  /// license-number with a status), alongside [licenseNumber]. Null
  /// means nothing has been submitted yet — a distinct state from
  /// "waiting on a human", same reasoning as Commuter.verificationStatus.
  /// Gates POST /driver/trips/start — a driver can't start a trip until
  /// this is APPROVED.
  licenseVerificationStatus IdVerificationStatus?

  /// Opaque random token encoded into this driver's QR code. Assigned
  /// once at account creation and permanent for the account's lifetime —
  /// no self-serve rotation. Nullable only so accounts created before
  /// this field existed don't need a backfill migration; GET
  /// /me/qr-token lazily fills it in for any that slip through. This is
  /// what makes the QR "backend-verified" rather than just one that
  /// encodes the driverId directly, which anyone could forge.
  qrToken       String?   @unique

  /// Soft-disable — same as Commuter.isActive.
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A single jeepney run — created when a driver taps "Start Trip" and
/// closed when they end it. [currentLat]/[currentLng] are overwritten in
/// place on each location ping while ACTIVE (no ping history table —
/// this powers "where is this jeepney right now" on the admin live map,
/// not a route-replay feature). There's deliberately no passenger count
/// here — a jeepney's manifest isn't tracked per-person or per-boarding
/// anywhere in this app, so a count would just be a guess dressed up as
/// data.
model Trip {
  id         String     @id @default(cuid())
  driverId   String
  route      String?
  status     TripStatus @default(ACTIVE)
  currentLat Float?
  currentLng Float?

  /// Set alongside [currentLat]/[currentLng] on each real location ping
  /// (see PATCH /api/driver/trips/:id/location) — never backfilled or
  /// simulated. Powers Jeepney Monitoring's "Last Updated" column and
  /// lets the admin map tell an actually-fresh position from a stale one,
  /// since [currentLat]/[currentLng] alone don't carry a timestamp.
  locationUpdatedAt DateTime?

  startedAt  DateTime   @default(now())
  endedAt    DateTime?

  /// Set by the backend, never the client, the moment a trip ends (see
  /// POST /api/driver/trips/:id/end) — two escalating duration tiers,
  /// both far more likely to indicate a problem than a real completed
  /// Pasig-Quiapo run: under 60 seconds (almost certainly an
  /// accidental/test tap of Start Trip immediately followed by End
  /// Trip) and under 5 minutes (still unusually brief — more likely a
  /// genuinely aborted trip than a mis-tap). Would also weigh trip
  /// distance if this app ever tracked one. Flagged, not hidden or
  /// auto-deleted — the record stays permanently and just carries a
  /// review trail (see the fields below). Also settable by an admin
  /// directly (see PATCH /api/admin/trips/:id/flag) for a manual flag
  /// unrelated to duration.
  isShortTrip Boolean @default(false)

  /// Auto-generated explanation of *why* the backend flagged this trip
  /// (e.g. "Trip lasted 0m 34s, below the 60-second minimum." or "Trip
  /// lasted 2m 10s — unusually brief for a completed Pasig–Quiapo run.")
  /// — the wording is what tells the two duration tiers apart, since
  /// they share the same isShortTrip boolean. Distinct from
  /// [driverExplanation] below, which is the driver's own account of what
  /// happened. Null for trips that were never flagged.
  flagReason String?

  /// The flagged trip's driver's own account of what happened, submitted
  /// via PATCH /api/driver/trips/:id/explanation. A driver may resubmit
  /// to update it (each call overwrites both this and
  /// [explanationSubmittedAt]) but can only ever do so for their own
  /// trip — enforced by that endpoint checking driverId, not by anything
  /// at this schema layer.
  driverExplanation      String?
  explanationSubmittedAt DateTime?

  /// Admin review trail — set only via PATCH /api/admin/trips/:id/review,
  /// never directly by a driver. [reviewedBy] is the reviewing Admin's id
  /// (joined to a name/email at read time the same way driverId is
  /// joined to a Driver elsewhere in this app — see loadDriversById).
  /// [adminReviewNote] is required by that endpoint when [reviewStatus]
  /// is set to INVALID, optional otherwise.
  reviewStatus    TripReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  adminReviewNote String?

  // Covers the dominant Trip History query shape on both platforms: "this
  // driver's trips, optionally COMPLETED-only, newest first" — a leading
  // driverId[, status] filter plus a startedAt-ordered scan, all from one
  // index instead of a table scan, which is what actually keeps this fast
  // once a driver has thousands/hundreds of thousands of trips. Replaces
  // the old bare [driverId, status] index — any query that used to use
  // that can use this one too (same leftmost columns), just faster once
  // startedAt ordering/range-filtering is involved.
  @@index([driverId, status, startedAt])
  // Route/flag filtering (admin + driver Trip History) narrows within an
  // already driverId-scoped query, so neither needs its own leading
  // position — these cover "this driver's trips on this route" / "...
  // that are/aren't flagged" without falling back to a full scan of one
  // driver's (potentially huge) trip history.
  @@index([driverId, route])
  @@index([driverId, isShortTrip])
  @@index([isShortTrip, reviewStatus])
  // Also indexed, SQL-only (Prisma's schema DSL has no partial-index
  // syntax): a `[driverId, startedAt DESC] WHERE "currentLat" IS NOT NULL`
  // partial index for GET /admin/jeepneys's "most recently located trip
  // per driver" query — see migration 20260814140000_pagination_indexes.
}

/// A commuter scanning a driver's QR code while that driver has an
/// ACTIVE trip — the actual, honest signal that someone is riding
/// (unlike the old anonymous per-scan counter this app used to have,
/// which got removed because it wasn't tied to a real rider). "Currently
/// on board" is read as: has a row here whose trip is still ACTIVE and
/// [alightedAt] is still null — set when the commuter taps "Para Po" in
/// the booking flow (see POST /api/commuter/alight), the app's existing
/// "I'm about to get off" signal. A boarding is also implicitly over
/// once the whole trip ends, Para Po or not.
/// One row per *ride segment* — a driver's Trip commonly spans a whole
/// shift (Start Trip in the morning, End Trip in the evening), and the
/// same commuter can honestly board and alight that same Trip more than
/// once in a day (rode it out, later rode it back). Each such segment
/// gets its own row, so ride history logs every one of them rather than
/// collapsing repeat rides on the same Trip into a single row — see POST
/// /api/commuter/board, which only reuses an existing row when the
/// commuter's *previous* boarding on this trip is still open (a
/// re-scan/re-confirm mid-ride), never once it's been alighted.
model TripBoarding {
  id         String    @id @default(cuid())
  tripId     String
  commuterId String
  boardedAt  DateTime  @default(now())
  alightedAt DateTime?

  /// The commuter's own party size at the moment they boarded — sent by
  /// POST /board, mirrored server-side so this survives a reinstall/
  /// new-device sync. There's no fare/payment feature in this app — this
  /// is purely a headcount. Null on boardings from before this existed.
  riders Int?

  // No longer a plain @@unique([tripId, commuterId]) — that made it
  // impossible to log more than one ride per commuter per Trip. Instead,
  // a partial unique index (Prisma's schema DSL has no syntax for this —
  // see this model's migration) enforces "at most one *open* boarding"
  // per (tripId, commuterId): `... WHERE "alightedAt" IS NULL`. Once
  // alighted, boarding that same trip again creates a fresh row.
  @@index([tripId])
  // Widened from a bare [commuterId] index — covers GET
  // /admin/commuters/:id/trips's "this commuter's ride history, newest
  // first" query (filter + sort from one index) the same way Trip's
  // [driverId, status, startedAt] does for Trip History.
  @@index([commuterId, boardedAt])
}

/// A commuter's anonymous "I want a ride here" ping — tapped from the
/// live map when they'd like a jeepney to know they're waiting, without
/// going through a formal booking flow. Deliberately never joined back to
/// a commuter identity in any API response (see GET /admin/demand-signals
/// and GET /driver/demand-signals): both endpoints only ever hand back
/// grid-cell clusters, never individual rows, so nothing downstream can
/// single out who sent a given ping.
model DemandSignal {
  id         String   @id @default(cuid())
  commuterId String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())

  /// The route this commuter picked before this signal was sent (see the
  /// route-and-companions step in jeepney_booking_flow_screen.dart) — lets
  /// GET /driver/demand-signals filter to just the driver's own route, so
  /// a driver running Pasig -> Quiapo doesn't get shown someone waiting
  /// for the opposite direction. Null on a signal sent before a route was
  /// ever known (shouldn't happen going forward — the trigger now waits
  /// for route selection — but kept nullable for old rows).
  route String?

  /// How many people this commuter is requesting a ride for — shown
  /// summed (not row-counted) in a map cluster's passenger count, so a
  /// group of 4 booked from one account actually reads as 4 waiting, not
  /// 1. Null on signals sent before this existed; treated as 1 (just the
  /// account itself) wherever a cluster sums this.
  partySize Int?

  /// Set the moment this signal stops representing someone still actually
  /// waiting — either they boarded a jeepney (see POST /api/commuter/board)
  /// or they stopped looking without boarding (backed out of the booking
  /// flow, left the app — see POST /api/commuter/demand-signals/cancel).
  /// Either way GET /admin/demand-signals and GET /driver/demand-signals
  /// stop surfacing it, even though it stays in the table (and still
  /// counts toward the day's total in commuter-stats' demandSignalsToday)
  /// rather than being deleted. Null means still outstanding.
  fulfilledAt DateTime?

  @@index([createdAt])
  // Covers POST /demand-signals' own "does this commuter already have an
  // outstanding signal" lookup — at most one unfulfilled row per commuter
  // is kept (refreshed in place rather than duplicated), so a long wait
  // never inflates a cluster's count with the same person pinging N times.
  @@index([commuterId, fulfilledAt])
}

/// A commuter's complaint against a driver — plateNumber is what the
/// commuter actually has on hand to identify who they're complaining
/// about (there's no per-trip passenger manifest to pick from — see
/// Trip's doc comment), resolved to a Driver row server-side at
/// submission time.
model Complaint {
  id              String           @id @default(cuid())
  complainantId   String
  driverId        String
  /// The specific ride this complaint is about, when filed from Trip
  /// History (where the commuter picked one particular trip) rather than
  /// the general "File a Complaint" flow (where they only know the
  /// driver's plate). Null there since there's nothing to link — see
  /// Trip's doc comment on why complaints aren't otherwise tied to a
  /// trip. Only used to answer "have I already reported this trip?".
  tripId          String?
  complaintType   String
  description     String
  attachmentUrl   String?
  status          ComplaintStatus  @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Widened from a bare [status] index — covers GET /admin/complaints's
  // paginated "optionally filtered by status, newest first" query (filter
  // + sort from one index), same reasoning as Trip's
  // [driverId, status, startedAt].
  @@index([status, createdAt])
  // Covers the same query's unfiltered ("All") case, where there's no
  // status to lead with.
  @@index([createdAt])
  @@index([driverId])
  @@index([tripId])
}

/// A commuter's 1-5 star rating of a driver for one specific ride —
/// requires having actually boarded that trip (see TripBoarding), one
/// rating per commuter per trip. [comment] mirrors the optional freeform
/// note the app's rating sheet collects. Driver's average is computed
/// on read (aggregate over this table), not denormalized anywhere.
model Rating {
  id         String   @id @default(cuid())
  tripId     String
  driverId   String
  commuterId String
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([tripId, commuterId])
  @@index([driverId])
}

model OtpCode {
  id            String     @id @default(cuid())
  /// A PH mobile number for commuter/driver purposes — or, for admin
  /// PASSWORD_RESET, the admin's email. Just an opaque identifier string
  /// as far as issueOtp/verifyOtp are concerned; not validated as a phone
  /// number at this layer.
  mobileNumber  String
  code          String
  purpose       OtpPurpose
  consumed      Boolean    @default(false)
  expiresAt     DateTime
  createdAt     DateTime   @default(now())

  @@index([mobileNumber, purpose])
}

/// A commuter sign-up that's passed phone verification but hasn't
/// finished ID + face verification yet — no Commuter row exists until
/// this ticket is redeemed (see POST /api/commuter/signup). Holds the
/// already-hashed password so nothing plaintext sits around waiting.
/// Given a generous expiry (well beyond the OTP's own 5-minute window)
/// since ID upload + a selfie can reasonably take a while.
model PendingCommuterSignup {
  id           String   @id @default(cuid())
  ticket       String   @unique
  fullName     String
  mobileNumber String
  passwordHash String

  /// Collected on the sign-up form itself (not a later step) — copied
  /// onto the Commuter row once /signup redeems this ticket. Nullable
  /// only so tickets created before this field existed don't break; the
  /// app always sends it going forward.
  dateOfBirth  DateTime? @db.Date

  /// Filled in by POST /signup/:ticket/id-photos and
  /// /signup/:ticket/selfie as the app moves through those screens —
  /// null until then. Copied onto the Commuter row once /signup redeems
  /// this ticket.
  idType       String?
  idFrontUrl   String?
  idBackUrl    String?
  selfieUrl    String?

  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// An operator/staff account for the admin web dashboard — separate from
/// Commuter/Driver, logs in with email+password instead of a PH mobile
/// number. Created via the create-admin CLI script (mirrors
/// scripts/create-driver.ts); there's no self-registration for this role.
/// Additional admins are created by the Main Admin from the Settings ->
/// Admin Accounts UI (see POST /api/admin/admins) instead of the CLI once
/// a Main Admin exists.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String

  /// There is always exactly one MAIN_ADMIN (also enforced by a partial
  /// unique index — see this model's migration) — full control over admin
  /// accounts (create, change role, deactivate, reset password). Every
  /// other account is a regular ADMIN, which has no admin-account-
  /// management privileges of its own; see requireMainAdmin in
  /// middleware/auth.ts, the only place this is ever checked. Bootstrapped
  /// by scripts/create-admin.ts (the very first admin created becomes
  /// MAIN_ADMIN); every admin created afterwards, from either the CLI or
  /// the UI, is a regular ADMIN.
  role         AdminRole @default(ADMIN)

  /// Soft-disable — same as Driver/Commuter.isActive. The Main Admin can
  /// never be deactivated (enforced in PATCH /admins/:id/status), so this
  /// is only ever meaningful for a regular ADMIN.
  isActive     Boolean   @default(true)

  /// Set on every successful POST /login — surfaced in the Admin Accounts
  /// table so the Main Admin can see who's actually using their access.
  /// Null until an admin's first login.
  lastLoginAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  MAIN_ADMIN
  ADMIN
}

/// A server-triggered notification for an async event the recipient
/// might not be looking at the app for. Distinct from the purely local,
/// client-generated notifications each app already keeps for in-session
/// events (trip completed, trip started) — this is fetched from the
/// backend and merged with those. Split into one table per recipient
/// type (Driver/Commuter/Admin) rather than a single polymorphic table
/// with a recipientType discriminator — each recipient's app only ever
/// queries its own table, so there's no shared-table filtering, and each
/// can evolve its own fields independently later without affecting the
/// others.
///
/// [type]/[referenceId] let a client make a notification tappable — e.g.
/// "TRIP_SHORT_FLAGGED", "TRIP_REVIEWED" (see notify*() call sites in
/// utils/notify.ts for the full set in use). Both null for a notification
/// with nothing to navigate to (e.g. "your plate number was updated").
model DriverNotification {
  id          String    @id @default(cuid())
  recipientId String
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  type        String?
  /// A Trip id — navigate to that trip's details.
  referenceId String?

  @@index([recipientId, isRead])
  // Covers the paginated "this recipient's notifications, newest first"
  // GET — [recipientId, isRead] above is for the mark-all-read bulk
  // update, a different query shape.
  @@index([recipientId, createdAt])
}

/// See DriverNotification's doc comment — same shape, commuter's own
/// table.
model CommuterNotification {
  id          String    @id @default(cuid())
  recipientId String
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  type        String?
  referenceId String?

  @@index([recipientId, isRead])
  // Covers the paginated "this recipient's notifications, newest first"
  // GET — [recipientId, isRead] above is for the mark-all-read bulk
  // update, a different query shape.
  @@index([recipientId, createdAt])
}

/// See DriverNotification's doc comment. No [recipientId] — admin's a
/// small shared team, so every row broadcasts to all admins rather than
/// targeting one; "mark read" is likewise a single shared flag per row,
/// not per-admin.
model AdminNotification {
  id          String   @id @default(cuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  type        String?
  /// A Driver id — navigate to that driver's detail panel, since that's
  /// where this app's trip review UI lives.
  referenceId String?

  @@index([isRead])
  // Covers the paginated "all admin notifications, newest first" GET.
  @@index([createdAt])
}

/// A driver's once-a-day self-reported summary — mirrors exactly what
/// the Daily Operations screen already collects (start/end odometer,
/// earnings, fuel, other expenses; distance/net-income/per-km figures
/// are derived client-side from these, same as before). Earnings/fuel/
/// expenses aren't tracked anywhere else in this app — jeepney fares
/// are cash, collected continuously through a trip from many riders,
/// not through any payment system — so this manual entry is the only
/// honest source for them. Weekly/Monthly Analytics and the admin
/// Operations Report are just date-range sums over these rows; trip
/// *counts* for those same views come from the real Trip table instead,
/// since those are honestly trackable. One row per driver per day —
/// upserted, so a driver can revise today's entry before the day ends.
model DriverDailyLog {
  id            String   @id @default(cuid())
  driverId      String
  date          DateTime @db.Date
  startOdo      Float
  endOdo        Float
  earnings      Float
  fuelExpense   Float    @default(0)
  otherExpenses Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([driverId, date])
  @@index([driverId, date])
}
