generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpPurpose {
  PASSWORD_RESET
  SIGNUP_VERIFICATION
  PHONE_CHANGE
}

model Commuter {
  id              String    @id @default(cuid())
  commuterId      String    @unique
  fullName        String
  mobileNumber    String    @unique
  passwordHash    String
  dateOfBirth     DateTime? @db.Date
  photoUrl        String?

  /// Set once the commuter verifies the OTP sent at signup. Null until
  /// then — nothing currently gates on this being set (the ID/KYC steps
  /// after it are still fully mocked), it's just a record that the
  /// number was actually confirmed.
  phoneVerifiedAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Driver {
  id            String    @id @default(cuid())
  driverId      String    @unique
  fullName      String
  mobileNumber  String    @unique
  passwordHash  String
  plateNumber   String
  dateOfBirth   DateTime? @db.Date
  photoUrl      String?

  /// Opaque random token encoded into this driver's QR code. Assigned
  /// once at account creation and permanent for the account's lifetime —
  /// no self-serve rotation. Nullable only so accounts created before
  /// this field existed don't need a backfill migration; GET
  /// /me/qr-token lazily fills it in for any that slip through. This is
  /// what makes the QR "backend-verified" rather than just one that
  /// encodes the driverId directly, which anyone could forge.
  qrToken       String?   @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OtpCode {
  id            String     @id @default(cuid())
  mobileNumber  String
  code          String
  purpose       OtpPurpose
  consumed      Boolean    @default(false)
  expiresAt     DateTime
  createdAt     DateTime   @default(now())

  @@index([mobileNumber, purpose])
}

/// A commuter sign-up that's passed phone verification but hasn't
/// finished ID + face verification yet — no Commuter row exists until
/// this ticket is redeemed (see POST /api/commuter/signup). Holds the
/// already-hashed password so nothing plaintext sits around waiting.
/// Given a generous expiry (well beyond the OTP's own 5-minute window)
/// since ID upload + a selfie can reasonably take a while.
model PendingCommuterSignup {
  id           String   @id @default(cuid())
  ticket       String   @unique
  fullName     String
  mobileNumber String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
