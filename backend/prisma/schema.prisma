generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpPurpose {
  PASSWORD_RESET
  SIGNUP_VERIFICATION
  PHONE_CHANGE
}

enum IdVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Commuter {
  id              String    @id @default(cuid())
  commuterId      String    @unique
  fullName        String
  mobileNumber    String    @unique
  passwordHash    String
  dateOfBirth     DateTime? @db.Date
  photoUrl        String?

  /// Set once the commuter verifies the OTP sent at signup. Null until
  /// then — nothing currently gates on this being set (the ID/KYC steps
  /// after it are still fully mocked), it's just a record that the
  /// number was actually confirmed.
  phoneVerifiedAt DateTime?

  /// Carried over from PendingCommuterSignup at signup redemption — the
  /// government ID type/photos and selfie captured during onboarding.
  /// Stored for the account's lifetime as the KYC record; nothing
  /// currently runs an actual face-match against [selfieUrl] (see the
  /// TODO on the face-verification screen) — these are just persisted.
  idType          String?
  idFrontUrl      String?
  idBackUrl       String?
  selfieUrl       String?

  /// Null until ID/selfie is submitted (nothing to review yet); set to
  /// PENDING the moment /signup redeems a ticket that has them, then
  /// moved to APPROVED/REJECTED by an admin via POST
  /// /api/admin/commuters/:id/verify. No automated face-match sets this
  /// — it's purely a manual review outcome.
  verificationStatus IdVerificationStatus?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Driver {
  id            String    @id @default(cuid())
  driverId      String    @unique
  fullName      String
  mobileNumber  String    @unique
  passwordHash  String
  plateNumber   String
  dateOfBirth   DateTime? @db.Date
  photoUrl      String?

  /// Opaque random token encoded into this driver's QR code. Assigned
  /// once at account creation and permanent for the account's lifetime —
  /// no self-serve rotation. Nullable only so accounts created before
  /// this field existed don't need a backfill migration; GET
  /// /me/qr-token lazily fills it in for any that slip through. This is
  /// what makes the QR "backend-verified" rather than just one that
  /// encodes the driverId directly, which anyone could forge.
  qrToken       String?   @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OtpCode {
  id            String     @id @default(cuid())
  mobileNumber  String
  code          String
  purpose       OtpPurpose
  consumed      Boolean    @default(false)
  expiresAt     DateTime
  createdAt     DateTime   @default(now())

  @@index([mobileNumber, purpose])
}

/// A commuter sign-up that's passed phone verification but hasn't
/// finished ID + face verification yet — no Commuter row exists until
/// this ticket is redeemed (see POST /api/commuter/signup). Holds the
/// already-hashed password so nothing plaintext sits around waiting.
/// Given a generous expiry (well beyond the OTP's own 5-minute window)
/// since ID upload + a selfie can reasonably take a while.
model PendingCommuterSignup {
  id           String   @id @default(cuid())
  ticket       String   @unique
  fullName     String
  mobileNumber String
  passwordHash String

  /// Filled in by POST /signup/:ticket/id-photos and
  /// /signup/:ticket/selfie as the app moves through those screens —
  /// null until then. Copied onto the Commuter row once /signup redeems
  /// this ticket.
  idType       String?
  idFrontUrl   String?
  idBackUrl    String?
  selfieUrl    String?

  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// An operator/staff account for the admin web dashboard — separate from
/// Commuter/Driver, logs in with email+password instead of a PH mobile
/// number. Created via the create-admin CLI script (mirrors
/// scripts/create-driver.ts); there's no self-registration for this role.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A forgot-password request for an Admin account. Deliberately separate
/// from OtpCode/OtpPurpose — those are keyed by PH mobile number for
/// SMS-style OTPs, while this is an email-addressed single-use link
/// token, matching how admin auth works differently from
/// commuter/driver. No email provider is wired up yet, so like OTP codes
/// today, the token is logged to the server console instead of actually
/// being emailed.
model AdminPasswordReset {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}
